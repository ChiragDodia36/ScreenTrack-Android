# ScreenTrack Release Configuration
# Copy this file to keystore.properties and fill in your values.
# DO NOT commit keystore.properties to version control.
#
# To generate a keystore:
#   keytool -genkey -v -keystore screentrack-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias screentrack

# ── Release Signing ──
SCREENTRACK_KEYSTORE_PATH=screentrack-release.jks
SCREENTRACK_KEYSTORE_PASSWORD=
SCREENTRACK_KEY_ALIAS=screentrack
SCREENTRACK_KEY_PASSWORD=

# ── Backend ──
BACKEND_URL=https://your-backend-url.hf.space
BACKEND_API_KEY=your_api_key_here
